# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
# JWT_SECRET signs the operator (dashboard) session. On Vercel/serverless it MUST
# be set as an environment variable — the filesystem fallback (DATA_DIR/jwt-secret)
# is ephemeral on Vercel and would invalidate every session on each cold start.
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# ============================================================
# Reseller platform (commercial AI-key billing)
# ============================================================
# Master switch for the reseller gateway, metering, and /api/reseller routes.
RESELLER_ENABLED=true

# Currency shown in the portal. Money is always stored as integer credit
# points (cp); 1000 cp = 1 currency unit. Integer math only, no float drift.
RESELLER_CURRENCY=USD
# Optional literal symbol (e.g. "Rp") prepended in portal displays.
# RESELLER_CURRENCY_SYMBOL=Rp

# Reseller store driver.
#   - Unset  -> SQLite at DATA_DIR/reseller.sqlite (local-first development).
#     Override the file with RESELLER_SQLITE_FILE=/path/to/reseller.sqlite.
#   - Set    -> PostgreSQL / Supabase (production). The first URL that is set
#     wins, in this order:
RESELLER_DATABASE_URL=
# RESELLER_SUPABASE_DATABASE_URL=
# POSTGRES_URL=
# DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres

# Secret used to sign customer session JWTs (HS256). Generate a long random
# value; do NOT reuse JWT_SECRET so a customer session can never be forged
# with the admin token key. Lifetime in seconds (default 7 days).
# On Vercel/serverless this MUST be set as an environment variable; the file
# fallback (DATA_DIR/reseller-session-secret) does not survive between invocations.
RESELLER_SESSION_SECRET=change-me-to-a-different-long-random-secret
# RESELLER_SESSION_MAX_AGE=604800

# Bootstrap admin (created on first boot if the email does not exist yet).
RESELLER_ADMIN_EMAIL=admin@example.com
RESELLER_ADMIN_PASSWORD=change-me
RESELLER_ADMIN_NAME=Platform Administrator

# Customer signup policy and welcome credit.
RESELLER_ALLOW_SIGNUP=true
# RESELLER_SIGNUP_BONUS_CP=0

# Default per-user rate limit (requests/minute). 0 = unlimited.
RESELLER_DEFAULT_RPM_LIMIT=60

# Minimum credit balance required to pass the pre-flight gate. A request is
# refused up-front when the balance would not cover even a minimal call.
RESELLER_MIN_BALANCE_CP=0

# Customer API key prefix. Anything starting with this is routed to the
# reseller store and metered — never to the local apiKeys table.
# RESELLER_KEY_PREFIX=sk-9r-

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router

